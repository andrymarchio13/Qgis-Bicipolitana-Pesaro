{
  "name": "bicipolitana-pesaro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Navigatore ciclabile della Bicipolitana di Pesaro",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "dev:mobile": "vite --mode mobile --host",
    "cert": "node scripts/make-cert.mjs",
    "cert:trust": "certutil -user -addstore Root certs/rootCA.crt",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "python scripts/validate-gis.py && python scripts/convert-gpkg.py && python scripts/build-routing-graph.py && python scripts/generate-metadata.py"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.5"
  }
}
