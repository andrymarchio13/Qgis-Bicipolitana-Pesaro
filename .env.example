# Copia questo file in `.env` e personalizza i valori.
# `.env` NON va mai committato: contiene le chiavi.

# --- Cartografia -----------------------------------------------------------
# Provider delle mattonelle. Default: CARTO Positron, lo stesso basemap usato
# nel progetto QGIS originale. L'attribuzione è obbligatoria.
VITE_BASEMAP_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO
VITE_BASEMAP_MAX_ZOOM=19

# Endpoint dei glifi per le etichette della mappa.
VITE_GLYPHS_URL=https://fonts.openmaptiles.org/{fontstack}/{range}.pbf

# --- Ricerca indirizzi -----------------------------------------------------
# Nominatim pubblico non richiede chiave ma ha limiti d'uso stringenti.
# In produzione conviene un'istanza propria o un servizio con chiave.
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
VITE_GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
VITE_GEOCODING_API_KEY=

# --- Segnalazioni ----------------------------------------------------------
VITE_REPORT_ISSUE_URL=

# --- Parametri di stima ----------------------------------------------------
VITE_CYCLING_SPEED_KMH=15
VITE_WALKING_SPEED_KMH=4.8
VITE_WALK_LEG_MIN_METERS=20
VITE_SNAP_MAX_DISTANCE_METERS=700
VITE_WALK_SNAP_MAX_DISTANCE_METERS=40000
VITE_REROUTE_DISTANCE_THRESHOLD=45
VITE_REROUTE_DEBOUNCE_MS=4000
VITE_REROUTE_COOLDOWN_MS=8000

# --- Percorso a piedi verso la rete ----------------------------------------
# Solo i tratti di collegamento fra il punto scelto e la rete coperta dai dati
# vengono calcolati su rete pedonale reale. Lasciare il valore vuoto disattiva
# la chiamata: il collegamento torna a essere una linea d'aria e il calcolo
# resta interamente offline.
VITE_WALK_ROUTING_URL=https://valhalla1.openstreetmap.de/route
VITE_WALK_ROUTING_TIMEOUT_MS=6000
VITE_WALK_ROUTING_MIN_METERS=40
# Se il percorso a piedi calcolato sulle strade supera di tanto la linea
# d'aria, in mezzo c'e' una barriera (autostrada, ferrovia): si tiene la linea
# d'aria invece di mostrare un giro di chilometri.
VITE_WALK_ROUTING_MAX_DETOUR=2.5
# Quanto pesa un minuto a piedi rispetto a uno in bicicletta.
VITE_WALK_COST_FACTOR=2.2
# Quanto conta la pericolosita' della strada su cui ci si innesta: a 0 il
# percorso sceglie sempre l'aggancio piu' vicino, anche sul ciglio di una
# strada a scorrimento.
VITE_WALK_SAFETY_WEIGHT=2.5
# Oltre questa lunghezza il raccordo fuori rete non si fa a piedi ma in
# bicicletta: chi chiede un percorso ciclabile la bici ce l'ha.
VITE_CONNECTOR_RIDE_THRESHOLD_METERS=500
