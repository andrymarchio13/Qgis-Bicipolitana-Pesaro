# Copia questo file in `.env` e personalizza i valori.
# `.env` NON va mai committato: contiene le chiavi.

# --- Cartografia -----------------------------------------------------------
# Stile vettoriale usato dalla mappa. Default: Positron di OpenFreeMap, senza
# chiave API, visivamente equivalente al basemap CARTO Positron del progetto
# QGIS originale. L'attribuzione è obbligatoria e non è rimovibile dall'app.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Mattonelle raster di ripiego, usate solo se lo stile non è raggiungibile.
VITE_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_BASEMAP_TILE_SIZE=256
VITE_BASEMAP_MAX_ZOOM=19
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors · sfondo OpenFreeMap

# Font delle etichette aggiunte dall'app: deve esistere fra i glifi dello stile.
VITE_MAP_LABEL_FONT=Noto Sans Bold

# Endpoint dei glifi, usato solo con il ripiego raster (che non ne porta uno).
VITE_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# --- Ricerca indirizzi -----------------------------------------------------
# Nominatim pubblico non richiede chiave ma ha limiti d'uso stringenti.
# In produzione conviene un'istanza propria o un servizio con chiave.
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
VITE_GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
VITE_GEOCODING_API_KEY=
VITE_GEOCODING_DEBOUNCE_MS=350
VITE_GEOCODING_TIMEOUT_MS=8000

# --- Segnalazioni ----------------------------------------------------------
VITE_REPORT_ISSUE_URL=

# --- Parametri di stima ----------------------------------------------------
VITE_CYCLING_SPEED_KMH=15
VITE_WALKING_SPEED_KMH=4.8
VITE_WALK_LEG_MIN_METERS=20
VITE_SNAP_MAX_DISTANCE_METERS=700
VITE_WALK_SNAP_MAX_DISTANCE_METERS=40000
VITE_REROUTE_DISTANCE_THRESHOLD=45
VITE_REROUTE_DEBOUNCE_MS=4000
VITE_REROUTE_COOLDOWN_MS=8000
# Distanza sotto la quale la destinazione si considera raggiunta.
VITE_ARRIVAL_THRESHOLD_METERS=25
# Precisione GPS oltre la quale la posizione è considerata inaffidabile.
VITE_GPS_MAX_ACCURACY_METERS=60

# --- Istruzioni di navigazione ---------------------------------------------
# Tratti più corti di questa soglia non generano un cambio di linea.
VITE_MIN_SEGMENT_LENGTH_METERS=120
# Angolo minimo (gradi) perché una variazione di direzione diventi una svolta,
# e angolo oltre il quale la svolta è secca.
VITE_TURN_ANGLE_THRESHOLD=35
VITE_SHARP_TURN_ANGLE=110

# --- Percorso a piedi verso la rete ----------------------------------------
# Solo i tratti di collegamento fra il punto scelto e la rete coperta dai dati
# vengono calcolati su rete pedonale reale. Lasciare il valore vuoto disattiva
# la chiamata: il collegamento torna a essere una linea d'aria e il calcolo
# resta interamente offline.
VITE_WALK_ROUTING_URL=https://valhalla1.openstreetmap.de/route
VITE_WALK_ROUTING_TIMEOUT_MS=6000
VITE_WALK_ROUTING_MIN_METERS=40
# Se il percorso a piedi calcolato sulle strade supera di tanto la linea
# d'aria, in mezzo c'e' una barriera (autostrada, ferrovia): si tiene la linea
# d'aria invece di mostrare un giro di chilometri.
VITE_WALK_ROUTING_MAX_DETOUR=2.5
# Quanto pesa un minuto a piedi rispetto a uno in bicicletta.
VITE_WALK_COST_FACTOR=2.2
# Quanto conta la pericolosita' della strada su cui ci si innesta: a 0 il
# percorso sceglie sempre l'aggancio piu' vicino, anche sul ciglio di una
# strada a scorrimento.
VITE_WALK_SAFETY_WEIGHT=2.5
# Oltre questa lunghezza il raccordo fuori rete non si fa a piedi ma in
# bicicletta: chi chiede un percorso ciclabile la bici ce l'ha.
VITE_CONNECTOR_RIDE_THRESHOLD_METERS=500

# --- Strade a traffico intenso ---------------------------------------------
# Quanto la penalita' di pericolosita' cresce piu' che proporzionalmente.
# A 0 la penalita' torna lineare e i percorsi tornano a preferire statali e
# provinciali appena sono un po' piu' corte.
VITE_DANGER_BOOST=2
# Oltre questi metri complessivi su strade a traffico intenso, il percorso lo
# dichiara con un avviso.
VITE_BUSY_ROAD_WARNING_METERS=150

# --- Alternative di percorso ------------------------------------------------
# Quanti percorsi mostrare al massimo per una stessa richiesta. Oltre ai
# profili, il router cerca altre strade evitando i tratti gia' proposti.
VITE_MAX_ROUTE_ALTERNATIVES=5
# Quanto due percorsi possono somigliarsi (frazione di lunghezza in comune).
# La prima soglia scarta i doppioni fra profili, la seconda impone che le
# alternative aggiungano davvero una strada diversa.
VITE_ROUTE_DUPLICATE_THRESHOLD=0.9
VITE_ROUTE_SIMILARITY_THRESHOLD=0.7
# Una variante deve restare lo stesso viaggio per un'altra strada: oltre questo
# allungamento rispetto al percorso migliore non viene proposta.
VITE_ROUTE_VARIANT_MAX_DETOUR=1.4
# ...e non puo' aggiungere piu' di questi metri di strade a traffico intenso.
VITE_ROUTE_VARIANT_MAX_BUSY_EXCESS=300
